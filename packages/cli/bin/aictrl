#!/usr/bin/env node

const childProcess = require("child_process")
const fs = require("fs")
const path = require("path")
const os = require("os")

function run(target) {
  const result = childProcess.spawnSync(target, process.argv.slice(2), {
    stdio: "inherit",
  })
  if (result.error) {
    console.error(result.error.message)
    process.exit(1)
  }
  const code = typeof result.status === "number" ? result.status : 0
  process.exit(code)
}

const platformNames = {
  darwin: "darwin",
  linux: "linux",
  win32: "windows",
}

// The platform packages that can hold this host's binary, preferred first.
// Each x64 OS has one package, the -baseline build: Bun ships the same binary
// for its baseline and AVX2 targets, so it runs on every x64 CPU. Linux has a
// glibc and a musl package; npm installs only the one whose `libc` matches the
// host, and the other stays a candidate for package managers that ignore
// `libc`.
function platformPackageNames(platform, arch, libc) {
  const variant = arch === "x64" ? "-baseline" : ""
  const glibcPackage = `@aictrl/cli-${platformNames[platform] || platform}-${arch}${variant}`
  if (platform !== "linux") return [glibcPackage]

  const muslPackage = `${glibcPackage}-musl`
  if (libc === "musl") return [muslPackage, glibcPackage]
  return [glibcPackage, muslPackage]
}

function isMuslLibrary(file) {
  return file.includes("libc.musl-") || file.includes("ld-musl-")
}

// The libc that Node's diagnostic report names for this process. npm reads the
// same report to decide which `libc` package to install.
function libcFromReport(report) {
  if (report && report.header && report.header.glibcVersionRuntime) return "glibc"
  if (report && Array.isArray(report.sharedObjects) && report.sharedObjects.some(isMuslLibrary)) return "musl"
  return undefined
}

function processReport() {
  try {
    process.report.excludeNetwork = true
    return process.report.getReport()
  } catch {
    return undefined
  }
}

// Reading the ldd script is one file read; building a diagnostic report takes
// a few milliseconds, so it is only the fallback for hosts without ldd, such
// as distroless images.
function linuxLibc(lddPath = "/usr/bin/ldd") {
  let ldd = ""
  try {
    ldd = fs.readFileSync(lddPath, "utf8")
  } catch {
    // no ldd on this host
  }
  if (ldd.includes("musl")) return "musl"
  if (ldd.includes("GNU C Library")) return "glibc"
  return libcFromReport(processReport())
}

function readPackageVersion(packageDir) {
  try {
    return JSON.parse(fs.readFileSync(path.join(packageDir, "package.json"), "utf8")).version
  } catch {
    return undefined
  }
}

// Every installed platform binary, nearest first. The walk starts in the
// wrapper's own package, so its own install tree is searched before any
// ancestor. Within one node_modules, packages keep the order of `names`.
function findPlatformBinaries(startDir, names, binary) {
  const found = []
  let current = startDir
  for (;;) {
    const modules = path.join(current, "node_modules")
    if (fs.existsSync(modules)) {
      for (const name of names) {
        const packageDir = path.join(modules, name)
        const target = path.join(packageDir, "bin", binary)
        if (fs.existsSync(target)) found.push({ name, packageDir, target, version: readPackageVersion(packageDir) })
      }
    }
    const parent = path.dirname(current)
    if (parent === current) {
      return found
    }
    current = parent
  }
}

// Versions and paths come from arbitrary ancestor node_modules, so strip
// control, bidi-override and zero-width characters before echoing them to
// the terminal.
function printable(text) {
  return String(text).replace(/[\u0000-\u001f\u007f-\u009f​-‏‪-‮⁦-⁩﻿]/g, "")
}

function unknownWrapperVersionMessage(wrapperPackageDir) {
  const manifest = printable(path.join(wrapperPackageDir, "package.json"))
  return [
    `Could not read the @aictrl/cli version from ${manifest}, so no platform binary can be verified.`,
    "Reinstall @aictrl/cli, or set AICTRL_BIN_PATH to the binary to run.",
  ].join("\n")
}

// `pinnedSpec` pins a package to the wrapper's release, so following the
// advice installs a binary the version check accepts.
function missingBinaryMessage({ names, skipped, wrapperVersion, wrapperPackageDir }) {
  if (!wrapperVersion) return unknownWrapperVersionMessage(wrapperPackageDir)

  const pinnedSpec = (name) => `${name}@${wrapperVersion}`
  const lines = [
    `@aictrl/cli ${wrapperVersion} found no aictrl binary of the same version for this platform.`,
    `It runs the binary from the platform package ${pinnedSpec(names[0])}, an optional dependency that your package manager did not install (for example because optional dependencies were omitted).`,
  ]
  if (skipped.length > 0) {
    lines.push("Skipped platform packages with a different version:")
    for (const entry of skipped) {
      lines.push(`  ${entry.name}@${printable(entry.version || "unknown")} at ${printable(entry.packageDir)}`)
    }
  }
  lines.push(
    `Reinstall ${pinnedSpec("@aictrl/cli")}, or install the platform package manually: npm install "${pinnedSpec(names[0])}"`,
  )
  const otherPackages = names.slice(1).map((n) => `"${pinnedSpec(n)}"`)
  if (otherPackages.length > 0) {
    lines.push("Other packages for this platform: " + otherPackages.join(", "))
  }
  lines.push("To run a specific binary instead, set AICTRL_BIN_PATH to its path.")
  return lines.join("\n")
}

function main() {
  // An explicit binary path is the caller's choice, so it skips the platform
  // package search and its version check below.
  const envPath = process.env.AICTRL_BIN_PATH
  if (envPath) {
    run(envPath)
  }

  const scriptDir = path.dirname(fs.realpathSync(__filename))

  const cached = path.join(scriptDir, ".aictrl")
  if (fs.existsSync(cached)) {
    run(cached)
  }

  const platform = os.platform()
  const libc = platform === "linux" ? linuxLibc() : undefined
  const names = platformPackageNames(platform, os.arch(), libc)
  const binary = platform === "win32" ? "aictrl.exe" : "aictrl"

  // Only a platform package of this wrapper's own release may run. An older
  // one left in an ancestor node_modules (CI images, npx caches) would
  // otherwise run silently whenever npm skipped the optional platform package.
  const wrapperPackageDir = path.resolve(scriptDir, "..")
  const wrapperVersion = readPackageVersion(wrapperPackageDir)
  const installed = findPlatformBinaries(scriptDir, names, binary)
  const matching = wrapperVersion && installed.find((entry) => entry.version === wrapperVersion)
  if (matching) {
    run(matching.target)
  }

  console.error(missingBinaryMessage({ names, skipped: installed, wrapperVersion, wrapperPackageDir }))
  process.exit(1)
}

if (require.main === module) {
  main()
} else {
  module.exports = { platformPackageNames, libcFromReport, linuxLibc }
}
