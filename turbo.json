{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["CI", "AICTRL_VERSION", "AICTRL_BUILD_SINGLE"],
  "globalPassThroughEnv": [
    "CI",
    "AICTRL_CHANNEL",
    "AICTRL_RELEASE",
    "GH_REPO"
  ],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
